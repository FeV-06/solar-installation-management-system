generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// First real domain record; additional workflows will be implemented separately.
model Enquiry {
  id              String   @id @default(uuid())
  customerName    String
  phone           String
  address         String
  systemType      String
  capacityKw      Int
  subsidyInterest Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
