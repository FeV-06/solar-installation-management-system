# Local API and customer site URLs. Change the host when running outside this computer.
SOL_API_BASE_URL=http://localhost:5228
SOL_CUSTOMER_SITE_URL=http://localhost:5173

# Baileys linked-device session. Keep this directory private and backed up securely.
SOL_WHATSAPP_AUTH_DIR=./runtime/auth

# Only direct individual chats are supported by this first version.
SOL_ALLOW_GROUPS=false

# Phone-call bot (Twilio Programmable Voice + Deepgram). Leave blank to disable phone calls.
# Configure the Twilio number's incoming voice webhook to https://<public-host>/voice/incoming (POST).
SOL_VOICE_PHONE_NUMBER=
SOL_VOICE_PUBLIC_URL=
SOL_VOICE_HOST=0.0.0.0
SOL_VOICE_PORT=3100
# Use a long random value (32+ characters); this protects the media-stream WebSocket.
SOL_VOICE_STREAM_TOKEN=
SOL_TWILIO_AUTH_TOKEN=
SOL_TWILIO_ACCOUNT_SID=
DEEPGRAM_API_KEY=
SOL_DEEPGRAM_VOICE=aura-2-thalia-en

# Optional, one-off outbound test call. Keep the limit short; the call uses Twilio and Deepgram balance.
SOL_VOICE_CALL_TARGET=
# Blank means no application duration limit; set a value from 1 to 14400 to enable one.
SOL_VOICE_OUTBOUND_MAX_SECONDS=
